@model RegistroViewModel
@{ViewData["Title"]="Crear cuenta";}
<section class="auth-layout"><div class="auth-story auth-editorial"><img class="auth-photo" src="/img/marca/editorial-accesorios.jpg" alt="Accesorios combinados con ropa negra" /><a class="logo brand brand-on-dark" href="/" aria-label="BlackCODE, inicio"><partial name="_Marca" /></a><p class="eyebrow">EL SIGUIENTE PASO ES TUYO</p><h1>Forma parte<br>del código.</h1><p>Piezas únicas. Personas auténticas.</p></div><div class="auth-form"><p class="eyebrow">CREAR CUENTA</p><h2>Crear cuenta</h2><form method="post"><div asp-validation-summary="ModelOnly"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="Nombre">Nombre completo</label><input asp-for="Nombre" autocomplete="name"/><span asp-validation-for="Nombre"></span><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo" autocomplete="email"/><span asp-validation-for="Correo"></span><label asp-for="Contrasena">Contraseña (mínimo 8 caracteres)</label><input asp-for="Contrasena" autocomplete="new-password" minlength="8"/><span asp-validation-for="Contrasena"></span><label asp-for="Confirmacion">Confirma tu contraseña</label><input asp-for="Confirmacion" autocomplete="new-password"/><span asp-validation-for="Confirmacion"></span><label class="checkbox"><input asp-for="AceptaTerminos"/> Acepto los <a href="/Home/Privacy">términos y privacidad</a>.</label><span asp-validation-for="AceptaTerminos"></span><button class="button full">Crear mi cuenta →</button></form><p>¿Ya tienes cuenta? <a class="underlined" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Inicia sesión</a></p></div></section>
