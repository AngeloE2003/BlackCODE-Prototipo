@model CatalogoViewModel
@{ViewData["Title"]="Accesorios con identidad";}
<section class="hero">
<div class="hero-main hero-editorial"><div class="hero-art"><img src="/img/marca/editorial-anillo-pulsera.jpg" alt="Anillo y pulsera de acero combinados con ropa negra" width="657" height="535" fetchpriority="high" /></div><div class="hero-copy"><p class="eyebrow">BLACKCODE / COLECCIÓN 01</p><h1>NO SIGAS<br>EL CÓDIGO.<br><em>CRÉALO.</em></h1><p>Piezas que hablan por ti.<br>Acero, actitud y ninguna regla.</p><a class="button light" href="/Catalogo">Explorar colección <span>↗</span></a></div><span class="hero-foot">DISEÑADO PARA SER TÚ — EST. 2026</span></div>
<div class="hero-side"><a href="/Catalogo?Buscar=anillo" class="collection-tile"><img src="/img/productos/anillo-vertice.svg" alt="Anillos de acero" /><div><p class="eyebrow">LOS ESENCIALES</p><h2>Anillos <span>↗</span></h2></div></a><a href="/Catalogo?Buscar=cadena" class="collection-tile dark"><img src="/img/productos/cadena-eslabones.svg" alt="Cadena de eslabones" /><div><p class="eyebrow">ACTITUD EN CADA DETALLE</p><h2>Cadenas <span>↗</span></h2></div></a></div>
</section>
<div class="brand-strip">INDEPENDIENTE POR NATURALEZA <span>✳</span> ACERO QUE PERDURA <span>✳</span> ESTILO SIN REGLAS <span>✳</span></div>
<section class="section"><div class="section-heading"><div><p class="eyebrow">PIEZAS QUE DEJAN HUELLA</p><h2>Elige tu próximo esencial.</h2></div><a class="underlined" href="/Catalogo">Ver todos los productos ↗</a></div><div class="product-grid home-grid">@foreach(var p in Model.Productos.Where(p=>p.Destacado).Take(4)){<partial name="_Producto" model="p"/>}</div></section>
