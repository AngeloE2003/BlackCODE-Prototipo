@model LoginViewModel
@{ViewData["Title"]="Iniciar sesión";}
<section class="auth-layout"><div class="auth-story auth-editorial"><img class="auth-photo" src="/img/marca/editorial-anillo-pulsera.jpg" alt="Anillo y pulsera de acero" /><a class="logo brand brand-on-dark" href="/" aria-label="BlackCODE, inicio"><partial name="_Marca" /></a><p class="eyebrow">BIENVENIDO A BLACKCODE</p><h1>Tu estilo.<br>Tu espacio.</h1><p>Todo lo que eliges dice algo de ti.</p></div><div class="auth-form"><p class="eyebrow">MI CUENTA</p><h2>Qué bueno verte.</h2><p class="muted">Ingresa para continuar con tu selección.</p><form method="post"><div asp-validation-summary="ModelOnly"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo" autocomplete="username"/><span asp-validation-for="Correo"></span><label asp-for="Contrasena">Contraseña</label><input asp-for="Contrasena" autocomplete="current-password"/><span asp-validation-for="Contrasena"></span><button class="button full">Iniciar sesión →</button></form><p>¿Primera vez aquí? <a class="underlined" asp-action="Registro" asp-route-returnUrl="@Model.ReturnUrl">Crea tu cuenta</a></p><a class="muted" href="/Catalogo">Seguir explorando sin iniciar sesión</a></div></section>
